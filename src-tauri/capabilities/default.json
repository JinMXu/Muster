{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capability set for Muster main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:event:default",
    "core:webview:default",
    "core:app:default",
    "dialog:default",
    "fs:default",
    "shell:default",
    "opener:default",
    "notification:default",
    "updater:default"
  ]
}