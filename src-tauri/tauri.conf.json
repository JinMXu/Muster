{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muster",
  "version": "0.1.3",
  "identifier": "dev.muster.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Muster",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["resources/OpenConsole.exe"],
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "shortDescription": "Terminal workspace",
    "longDescription": "A native terminal workspace for Windows.",
    "windows": {
      "nsis": { "installMode": "perMachine" },
      "wix": { "language": ["en-US"] }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JinMXu/Muster/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFQkQ3NTg5ODUwQUUxQTIKUldTaTRRcUZpWFc5WHZnaEU2VmQ0cGZhaGc3VUJnZlE4ci9QSW9sUFZjRExLbXhOR0RlcTlvRkMK",
      "windows": {
        "installMode": "passive"
      }
    },
    "process": {}
  }
}
